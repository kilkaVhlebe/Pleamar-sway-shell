// The control center: a panel at the top right, over a dimmed desktop. The
// network, the bluetooth, the sound, the notices and the power. It opens from
// the diamond in the bar —`pleamar --say center "emit toggle"`— and closes on
// Escape, on ×, or on a press on the dimmed part.
//
// Geometry (all written inline, against screen.width): the panel is 380 × 622
// at x = screen.width - 387, y = 50. Inside it, 16 of padding and a content
// column 348 wide from x = screen.width - 371:
//   header 66..94 · Wi-Fi card 106..298 · Bluetooth card 306..468 ·
//   sound card 476..540 · notices 548..588 · power tiles 596..656.

import "../common/palette.plm"

scene Center {
    surface {
        size: full, full
        anchor: top_left
        level: overlay
        //  Kept while the panel slides away, so the close is seen.
        open: open or shown > 0.01
        screens: each
        keyboard: exclusive while open
    }

    permissions { services: "network", "network.*", "bluetooth", "bluetooth.*", "audio", "audio.*", "session.*", "say:bar", "say:notes" }


    // ── the boundary: what the system says ───────────────────────
    service network as net { online: bool; kind: wired | wifi | none; wifi: bool; strength: number; name: text; error: password | timeout | unsupported | busy | failed | none }
    service bluetooth as bt {
        present: bool
        powered: bool
        discovering: bool
        pairing: pin | passkey | confirm | display | authorize | none
        pairing_id: number
        pairing_code: text
        pairing_name: text
    }

    model wifi_nets max 12 { ssid: text; note: text; active: number; secure: bool; known: bool; strength: number }
    model bt_devs max 12 { name: text; sub: text; address: text; connected: number; icon: image 20, 20 }

    fact volume = 0
    fact muted  = false
    fact note_count = 0
    event note_count ->                   // (count): from the notification centre

    fact open = false
    fact suppress = false                 // the release of Super after Super+D
    fact pwd_open = false
    fact pwd_error = false
    text pwd_name = ""
    text pwd_value = ""
    text pair_code = ""
    fact ask = 0                          // 0: nothing · 1: power off · 2: restart
    fact ask_last = 1                     // what the confirm says while it fades out
    fact beat = false                     // the scan's pulse, only while discovering

    event toggle                          // from the bar, or from the key
    event suppress ->                     // from the launcher
    event connect_net ->                  // (i): join that network
    event pwd_submit ->                   // the password has been typed
    event wifi_toggle ->
    event bt_toggle ->
    event bt_scan ->
    event bt_tap ->                       // (i): connect or disconnect
    event pair_answer ->                  // a code has been typed
    event pair_accept ->
    event pair_reject ->
    event volume_set ->                   // (0..1)
    event mute ->
    event ask_power ->                    // (1: off · 2: restart)
    event do_power ->                     // confirmed
    event cancel_power ->
    event suspend ->
    event open_notes ->


    // ── motion ───────────────────────────────────────────────────
    //  The panel: in over 240 ms, out over 150, no overshoot.
    prop shown = 0 ~240ms
    layer fold {
        opened while open { shown: 1 ~240ms }
        closed            { shown: 0 ~150ms }
    }

    prop wifi_on = 0 ~calm
    follow wifi_on = if(net.wifi, 1, 0)
    prop bt_on = 0 ~calm
    follow bt_on = if(bt.powered, 1, 0)
    prop lvl = 0 ~120ms                   // the slider's fill, eased
    follow lvl = clamp(volume, 0, 1)
    prop mut = 0 ~quick
    follow mut = if(muted, 1, 0)
    prop pulse = 0 ~550ms
    follow pulse = if(beat and bt.discovering, 1, 0)

    //  The dialogs: each its own card, and one veil for all.
    prop veil = 0 ~180ms
    follow veil = if(pwd_open or ask != 0 or bt.pairing != none, 1, 0)
    prop pwd_t = 0 ~180ms
    follow pwd_t = if(pwd_open, 1, 0)
    prop pair_t = 0 ~180ms
    follow pair_t = if(bt.pairing != none, 1, 0)
    prop ask_t = 0 ~180ms
    follow ask_t = if(ask != 0, 1, 0)


    // ── the desktop, dimmed just a little ────────────────────────
    //  Declared first: every button after it wins the press over it.
    box dim { from: 0, 0; size: screen.width, screen.height; color: #000000; opacity: 20% * shown }


    // ── the panel ────────────────────────────────────────────────
    group {
        pivot: screen.width - 7, 50
        scale: 0.98 + 0.02 * shown
        move: 12 * (1 - shown), -6 * (1 - shown)
        opacity: shown

        body {
            gradient: 0, 50 to 0, 672, panel, #111419
            rim: 5%
            light: 3%, 50, 120
            border: 1, edge
            shadow: 0, 18, 44, 30%
            box { from: screen.width - 387, 50; size: 380, 622; corner: 14 }
        }

        // ── the header ───────────────────────────────────────────
        text "Центр управления" { at: screen.width - 371, 80; anchor: left center; size: 16; weight: 700; color: ink }

        box { from: screen.width - 51, 66; size: 28, 28; corner: 8; color: hover; opacity: close_hit.hover * (1 - 0.3 * close_hit.pressed) }
        line { from: screen.width - 41.5, 75.5; to: screen.width - 32.5, 84.5; width: 1.6; color: mix(soft, ink, close_hit.hover) }
        line { from: screen.width - 41.5, 84.5; to: screen.width - 32.5, 75.5; width: 1.6; color: mix(soft, ink, close_hit.hover) }
        zone box close_hit { from: screen.width - 51, 66; size: 28, 28; corner: 8; cursor: pointer; label: "Закрыть" }

        // ── Wi-Fi ────────────────────────────────────────────────
        body {
            color: raised; rim: 4%
            box { from: screen.width - 371, 106; size: 348, 192; corner: 12 }
        }
        box { from: screen.width - 361, 114; size: 28, 28; corner: 8; color: mix(edge, mint, wifi_on) }
        WifiGlyph(mix(soft, ink, wifi_on)) { move: screen.width - 357, 118 }
        text "Wi-Fi" { at: screen.width - 325, 121; anchor: left center; size: 13; weight: 700; color: ink }
        text net.name { at: screen.width - 325, 136; anchor: left center; size: 10.5; width: 170; lines: 1; color: soft
                        show: net.wifi and net.online and net.kind == wifi }
        text "Не подключено" { at: screen.width - 325, 136; anchor: left center; size: 10.5; color: soft
                               show: net.wifi and not (net.online and net.kind == wifi) }
        text "Выключен" { at: screen.width - 325, 136; anchor: left center; size: 10.5; color: soft; show: not net.wifi }
        Switch(net.wifi, pressed: wifi_toggle) { move: screen.width - 73, 117 }

        column wifilist { at: screen.width - 365, 150; view: 336, 142; gap: 2; show: net.wifi
            for n in wifi_nets { NetRow(n) }
        }
        text "Сети не найдены" { at: screen.width - 197, 221; anchor: center; size: 12; color: soft; show: wifi_nets.count == 0 and net.wifi }
        text "Wi-Fi выключен" { at: screen.width - 197, 221; anchor: center; size: 12; color: soft; show: not net.wifi }

        // ── Bluetooth ────────────────────────────────────────────
        body {
            color: raised; rim: 4%
            box { from: screen.width - 371, 306; size: 348, 162; corner: 12 }
        }
        box { from: screen.width - 361, 314; size: 28, 28; corner: 8; color: mix(edge, mint, bt_on) }
        BtGlyph(mix(soft, ink, bt_on)) { move: screen.width - 357, 318 }
        text "Bluetooth" { at: screen.width - 325, 321; anchor: left center; size: 13; weight: 700; color: ink }
        text "Поиск устройств…" { at: screen.width - 325, 336; anchor: left center; size: 10.5; color: mix(mint, ink, 0.35); show: bt.powered and bt.discovering }
        text "Включён" { at: screen.width - 325, 336; anchor: left center; size: 10.5; color: soft; show: bt.powered and not bt.discovering }
        text "Выключен" { at: screen.width - 325, 336; anchor: left center; size: 10.5; color: soft; show: not bt.powered }
        Switch(bt.powered, pressed: bt_toggle) { move: screen.width - 73, 317 }

        //  The scan: a pill left of the switch; while it scans, a pulsing dot.
        box { from: screen.width - 153, 317; size: 72, 22; corner: 11
              color: mix(mix(hover, bluesoft, bt.discovering), ink, 0.08 * scan_hit.hover)
              opacity: 1 - 0.2 * scan_hit.pressed; show: bt.powered }
        text "Поиск" { at: screen.width - 117, 328; anchor: center; size: 11; color: ink; show: bt.powered and not bt.discovering }
        ellipse { at: screen.width - 141, 328; radius: 3; color: mint; opacity: 0.35 + 0.65 * pulse; show: bt.discovering }
        text "поиск…" { at: screen.width - 112, 328; anchor: center; size: 11; color: mix(mint, ink, 0.35); show: bt.discovering }
        zone box scan_hit { from: screen.width - 153, 317; size: 72, 22; corner: 11; cursor: pointer; label: "Поиск устройств"; show: bt.powered }

        column btlist { at: screen.width - 365, 350; view: 336, 112; gap: 2; show: bt.powered
            for d in bt_devs { BtRow(d) }
        }
        text "Устройств нет" { at: screen.width - 197, 398; anchor: center; size: 12; color: soft; show: bt_devs.count == 0 and bt.powered }
        text "Нажмите «Поиск», чтобы найти устройства рядом" { at: screen.width - 197, 416; anchor: center; size: 10.5; color: soft; opacity: 70%
                                                             show: bt_devs.count == 0 and bt.powered and not bt.discovering }
        text "Bluetooth выключен" { at: screen.width - 197, 406; anchor: center; size: 12; color: soft; show: not bt.powered }

        // ── the sound ────────────────────────────────────────────
        body {
            color: raised; rim: 4%
            box { from: screen.width - 371, 476; size: 348, 64; corner: 12 }
        }
        box { from: screen.width - 359, 490; size: 36, 36; corner: 10
              color: mix(mix(bluesoft, redsoft, mut), ink, 0.07 * mute_hit.hover)
              opacity: 1 - 0.2 * mute_hit.pressed }
        SpeakerGlyph(mix(mint, red, mut), 1 - mut, mut) { move: screen.width - 351, 498 }
        zone box mute_hit { from: screen.width - 359, 490; size: 36, 36; corner: 10; cursor: pointer; label: "Без звука" }

        text if(muted, "Звук выключен", "Громкость") { at: screen.width - 311, 496; anchor: left center; size: 12.5; color: ink }
        text "{volume * 100, 0}%" { at: screen.width - 37, 496; anchor: right center; size: 11; color: soft; width: 60; align: right }

        //  The slide: 274 wide from screen.width - 311, 0..1.
        box { from: screen.width - 311, 517; size: 274, 6; corner: 3; color: mix(edge, soft, 0.18) }
        box { from: screen.width - 311, 517; size: lvl * 274, 6; corner: 3; color: mix(mint, soft, mut) }
        body {
            color: ink
            shadow: 0, 1, 4, 30%
            ellipse { at: screen.width - 311 + lvl * 274, 520; radius: 6 + 2 * max(track.hover, track.pressed) }
        }
        zone box track { from: screen.width - 319, 506; size: 290, 28; corner: 8; cursor: pointer; label: "Громкость" }

        // ── the notices ──────────────────────────────────────────
        body {
            color: mix(raised, hover, notes_hit.hover); rim: 4%
            box { from: screen.width - 371, 548; size: 348, 40; corner: 10 }
        }
        BellGlyph(mix(soft, ink, notes_hit.hover)) { move: screen.width - 357, 558 }
        text "Уведомления" { at: screen.width - 325, 568; anchor: left center; size: 12.5; color: ink }
        box { from: screen.width - 85, 558; size: 30, 20; corner: 10; color: if(note_count > 0, mint, edge) }
        text "{note_count}" { at: screen.width - 70, 568; anchor: center; size: 11; weight: 700; color: if(note_count > 0, coal, soft) }
        path { at: screen.width - 43, 564; stroke: 1.6; color: soft; opacity: 0.6 + 0.4 * notes_hit.hover
               move 0, 0; line 4, 4; line 0, 8 }
        zone box notes_hit { from: screen.width - 371, 548; size: 348, 40; corner: 10; cursor: pointer }

        // ── the power ────────────────────────────────────────────
        group {
            pivot: screen.width - 315, 626
            scale: 1 - 0.04 * off_hit.pressed
            body {
                color: mix(raised, redsoft, off_hit.hover); rim: 4%
                box { from: screen.width - 371, 596; size: 112, 60; corner: 12 }
            }
            PowerGlyph(red) { move: screen.width - 325, 606 }
            text "Выключить" { at: screen.width - 315, 640; anchor: center; size: 11; color: mix(soft, ink, off_hit.hover) }
        }
        zone box off_hit { from: screen.width - 371, 596; size: 112, 60; corner: 12; cursor: pointer }
        group {
            pivot: screen.width - 197, 626
            scale: 1 - 0.04 * reboot_hit.pressed
            body {
                color: mix(raised, bluesoft, reboot_hit.hover); rim: 4%
                box { from: screen.width - 253, 596; size: 112, 60; corner: 12 }
            }
            RebootGlyph(mint) { move: screen.width - 207, 606 }
            text "Перезагрузка" { at: screen.width - 197, 640; anchor: center; size: 11; color: mix(soft, ink, reboot_hit.hover) }
        }
        zone box reboot_hit { from: screen.width - 253, 596; size: 112, 60; corner: 12; cursor: pointer }
        group {
            pivot: screen.width - 79, 626
            scale: 1 - 0.04 * suspend_hit.pressed
            body {
                color: mix(raised, hover, suspend_hit.hover); rim: 4%
                box { from: screen.width - 135, 596; size: 112, 60; corner: 12 }
            }
            MoonGlyph(ink, mix(raised, hover, suspend_hit.hover)) { move: screen.width - 89, 606 }
            text "Сон" { at: screen.width - 79, 640; anchor: center; size: 11; color: mix(soft, ink, suspend_hit.hover) }
        }
        zone box suspend_hit { from: screen.width - 135, 596; size: 112, 60; corner: 12; cursor: pointer }


        // ── the veil: while a dialog is up, the panel waits ──────
        //  A zone over the whole panel, after its buttons: nothing under a
        //  dialog can be pressed, and a press on it closes the dialog.
        box { from: screen.width - 387, 50; size: 380, 622; corner: 14; color: #05070a; opacity: 55% * veil }
        zone box modal { from: screen.width - 387, 50; size: 380, 622; corner: 14; active: pwd_open or ask != 0 or bt.pairing != none }


        // ── the password, asked of whoever sits there ────────────
        //  Card 316 × 188 at (screen.width - 355, 267).
        group {
            show: pwd_t > 0.01
            opacity: pwd_t
            pivot: screen.width - 197, 361
            scale: 0.96 + 0.04 * pwd_t
            body {
                color: raised; rim: 6%; border: 1, edge
                shadow: 0, 14, 36, 32%
                box { from: screen.width - 355, 267; size: 316, 188; corner: 14 }
            }
            zone box pwd_card { from: screen.width - 355, 267; size: 316, 188; corner: 14; active: pwd_open }
            text "Пароль Wi-Fi" { at: screen.width - 339, 295; anchor: left center; size: 15; weight: 700; color: ink }
            text pwd_name { at: screen.width - 339, 315; anchor: left center; size: 12; width: 284; lines: 1; color: soft }
            box { from: screen.width - 339, 331; size: 284, 36; corner: 8; color: coal }
            box { from: screen.width - 339, 331; size: 284, 36; corner: 8; stroke: 1.2; color: if(pwd_error, red, mint); opacity: 70% }
            input pwd_value { at: screen.width - 327, 341; width: 260; size: 14; color: ink; secret: true; placeholder: "не короче 8 знаков"; selection: bluesoft; show: pwd_open }
            text "Не удалось подключиться — проверьте пароль" { at: screen.width - 339, 383; anchor: left center; size: 11; color: red; show: pwd_error }
            Button("Отмена", 138, hover, ink, pwd_cancel.hover, pwd_cancel.pressed) { move: screen.width - 339, 407 }
            zone box pwd_cancel { from: screen.width - 339, 407; size: 138, 32; corner: 9; cursor: pointer; active: pwd_open }
            Button("Подключить", 138, mint, coal, pwd_ok.hover, pwd_ok.pressed) { move: screen.width - 193, 407 }
            zone box pwd_ok { from: screen.width - 193, 407; size: 138, 32; corner: 9; cursor: pointer; active: pwd_open }
        }

        // ── bluetooth pairing, as BlueZ asks ─────────────────────
        //  Card 316 × 228 at (screen.width - 355, 247).
        group {
            show: pair_t > 0.01
            opacity: pair_t
            pivot: screen.width - 197, 361
            scale: 0.96 + 0.04 * pair_t
            body {
                color: raised; rim: 6%; border: 1, edge
                shadow: 0, 14, 36, 32%
                box { from: screen.width - 355, 247; size: 316, 228; corner: 14 }
            }
            zone box pair_card { from: screen.width - 355, 247; size: 316, 228; corner: 14; active: bt.pairing != none }
            text "Сопряжение" { at: screen.width - 339, 275; anchor: left center; size: 15; weight: 700; color: ink }
            text bt.pairing_name { at: screen.width - 339, 295; anchor: left center; size: 12; width: 284; lines: 1; color: soft }
            text "Введите PIN с устройства" { at: screen.width - 339, 319; anchor: left center; size: 11.5; color: soft; show: bt.pairing == pin }
            text "Введите код с устройства" { at: screen.width - 339, 319; anchor: left center; size: 11.5; color: soft; show: bt.pairing == passkey }
            text "Этот код введите на устройстве" { at: screen.width - 339, 319; anchor: left center; size: 11.5; color: soft; show: bt.pairing == display }
            text "Совпадает ли код?" { at: screen.width - 339, 319; anchor: left center; size: 11.5; color: soft; show: bt.pairing == confirm }
            text "Разрешить сопряжение?" { at: screen.width - 339, 319; anchor: left center; size: 11.5; color: soft; show: bt.pairing == authorize }
            box { from: screen.width - 339, 337; size: 284, 52; corner: 10; color: coal; show: bt.pairing == display or bt.pairing == confirm }
            text bt.pairing_code { at: screen.width - 197, 363; anchor: center; size: 26; weight: 700; color: mix(mint, ink, 0.2); show: bt.pairing == display or bt.pairing == confirm }
            box { from: screen.width - 339, 343; size: 284, 36; corner: 8; color: coal; show: bt.pairing == pin or bt.pairing == passkey }
            box { from: screen.width - 339, 343; size: 284, 36; corner: 8; stroke: 1.2; color: mint; opacity: 70%; show: bt.pairing == pin or bt.pairing == passkey }
            input pair_code { at: screen.width - 327, 353; width: 260; size: 14; color: ink; placeholder: "код"; selection: bluesoft; show: bt.pairing == pin or bt.pairing == passkey }
            Button("Отмена", 138, hover, ink, pair_no.hover, pair_no.pressed) { move: screen.width - 339, 427 }
            zone box pair_no { from: screen.width - 339, 427; size: 138, 32; corner: 9; cursor: pointer; active: bt.pairing != none }
            Button("Ответить", 138, mint, coal, pair_yes.hover, pair_yes.pressed) { move: screen.width - 193, 427 }
            zone box pair_yes { from: screen.width - 193, 427; size: 138, 32; corner: 9; cursor: pointer; active: bt.pairing != none }
        }

        // ── the power, confirmed ─────────────────────────────────
        //  Card 316 × 152 at (screen.width - 355, 285).
        group {
            show: ask_t > 0.01
            opacity: ask_t
            pivot: screen.width - 197, 361
            scale: 0.96 + 0.04 * ask_t
            body {
                color: raised; rim: 6%; border: 1, edge
                shadow: 0, 14, 36, 32%
                box { from: screen.width - 355, 285; size: 316, 152; corner: 14 }
            }
            zone box ask_card { from: screen.width - 355, 285; size: 316, 152; corner: 14; active: ask != 0 }
            ellipse { at: screen.width - 321, 319; radius: 18; color: redsoft }
            PowerGlyph(red) { move: screen.width - 331, 309; show: ask_last == 1 }
            RebootGlyph(red) { move: screen.width - 331, 309; show: ask_last == 2 }
            text if(ask_last == 1, "Выключить компьютер?", "Перезагрузить компьютер?") { at: screen.width - 291, 311; anchor: left center; size: 15; weight: 700; color: ink }
            text "Действие нельзя отменить после подтверждения." { at: screen.width - 291, 331; anchor: left top; size: 11; width: 236; lines: 2; color: soft }
            Button("Отмена", 138, hover, ink, ask_cancel.hover, ask_cancel.pressed) { move: screen.width - 339, 389 }
            zone box ask_cancel { from: screen.width - 339, 389; size: 138, 32; corner: 9; cursor: pointer; active: ask != 0 }
            Button("Подтвердить", 138, red, ink, ask_ok.hover, ask_ok.pressed) { move: screen.width - 193, 389 }
            zone box ask_ok { from: screen.width - 193, 389; size: 138, 32; corner: 9; cursor: pointer; active: ask != 0 }
        }
    }


    // ── one switch ───────────────────────────────────────────────
    //  The knob slides with a small spring; the track goes from slate to accent.
    component Switch(on: bool, pressed: event) {
        size: 40, 22
        prop pos = 0 ~lively
        follow pos = if(on, 1, 0)
        box { from: 0, 0; size: 40, 22; corner: 11
              color: mix(mix(mix(edge, soft, 0.22), mint, pos), ink, 0.08 * touch.hover)
              opacity: 1 - 0.15 * touch.pressed }
        body {
            color: mix(#c9ced8, #ffffff, pos)
            shadow: 0, 1, 3, 30%
            ellipse { at: 11 + 18 * pos, 11; radius: 8 + 0.5 * touch.hover }
        }
        zone box touch { from: -4, -4; size: 48, 30; corner: 15; cursor: pointer }
        on press touch { emit pressed }
    }

    // ── a dialog's button: its plate and its word ────────────────
    //  The zone is the scene's (its name is in the rules); this only draws.
    component Button(caption: text, w: number, ground: color, tone: color, hot: number, down: number) {
        size: w, 32
        box { from: 0, 0; size: w, 32; corner: 9; color: mix(ground, #ffffff, 0.1 * hot); opacity: 1 - 0.18 * down }
        text caption { at: w / 2, 16; anchor: center; size: 12; weight: 700; color: tone }
    }

    // ── one network ──────────────────────────────────────────────
    //  Signal bars (strength 0..1), the name, and the state on the right.
    //  The joined one sits on the accent's ground with a bar on its left.
    component NetRow(n: record) {
        size: 336, 34
        prop act = 0 ~calm
        follow act = n.active
        box { from: 0, 0; size: 336, 34; corner: 8; color: hover; opacity: 70% * hit.hover }
        box { from: 0, 0; size: 336, 34; corner: 8; color: mix(bluesoft, #26467a, hit.hover); opacity: act }
        box { from: 0, 9; size: 3, 16; corner: 1.5; color: mint; opacity: act }
        repeat k in 0..4 {
            box { from: 12 + k * 4, 24 - (4 + 3 * k); size: 3, 4 + 3 * k; corner: 1
                  color: if(n.active, mint, ink); opacity: if(n.strength > k * 0.25, 0.85, 0.2) }
        }
        text n.ssid { at: 36, 17; anchor: left center; size: 12.5; weight: if(n.active, 700, 400); width: 200; lines: 1; color: ink }
        text n.note { at: 324, 17; anchor: right center; size: 10; color: if(n.active, mix(mint, ink, 0.35), soft) }
        zone box hit { from: 0, 0; size: 336, 34; corner: 8; cursor: pointer }
        on press hit { emit connect_net(n.index) }
    }

    // ── one bluetooth device ─────────────────────────────────────
    component BtRow(d: record) {
        size: 336, 36
        prop act = 0 ~calm
        follow act = d.connected
        box { from: 0, 0; size: 336, 36; corner: 8; color: hover; opacity: 70% * hit.hover }
        box { from: 0, 0; size: 336, 36; corner: 8; color: mix(bluesoft, #26467a, hit.hover); opacity: act }
        box { from: 0, 10; size: 3, 16; corner: 1.5; color: mint; opacity: act }
        ellipse { at: 22, 18; radius: 13; color: edge; opacity: 0.7 }
        image d.icon { at: 12, 8; size: 20, 20 }
        text d.name { at: 44, 12; anchor: left center; size: 12.5; weight: if(d.connected, 700, 400); width: 270; lines: 1; color: ink }
        text d.sub { at: 44, 26; anchor: left center; size: 10; width: 270; lines: 1; color: if(d.connected, mix(mint, ink, 0.35), soft) }
        zone box hit { from: 0, 0; size: 336, 36; corner: 8; cursor: pointer }
        on press hit { emit bt_tap(d.index) }
    }

    // ── glyphs, drawn rather than typed (each in a 20 × 20 box) ──
    //  Wi-Fi: three fans over a dot. Each fan is a quarter circle as one
    //  quadratic curve: ends at ±0.707 r, control at 1.414 r above the dot.
    component WifiGlyph(tone: color) {
        size: 20, 20
        path { at: 10, 15; stroke: 1.7; color: tone; move -2.8, -2.8; curve 2.8, -2.8 via 0, -5.7 }
        path { at: 10, 15; stroke: 1.7; color: tone; move -5.3, -5.3; curve 5.3, -5.3 via 0, -10.6 }
        path { at: 10, 15; stroke: 1.7; color: tone; move -7.8, -7.8; curve 7.8, -7.8 via 0, -15.6 }
        ellipse { at: 10, 15; radius: 1.7; color: tone }
    }

    //  Bluetooth: the rune as one stroke.
    component BtGlyph(tone: color) {
        size: 20, 20
        path { at: 10, 10; stroke: 1.6; color: tone
               move -3.5, -3.5; line 3.5, 3.5; line 0, 7; line 0, -7; line 3.5, -3.5; line -3.5, 3.5 }
    }

    //  A speaker; with waves, or with a cross when muted (`waves`/`cross` fade).
    component SpeakerGlyph(tone: color, waves: number, cross: number) {
        size: 20, 20
        path { at: 8, 10; color: tone
               move -6, -2.5; line -3, -2.5; line 1, -6; line 1, 6; line -3, 2.5; line -6, 2.5; close }
        path { at: 8, 10; stroke: 1.6; color: tone; opacity: waves; move 3.5, -3; curve 3.5, 3 via 6.5, 0 }
        path { at: 8, 10; stroke: 1.6; color: tone; opacity: waves; move 5.5, -6; curve 5.5, 6 via 11, 0 }
        line { from: 12, 7; to: 18, 13; width: 1.6; color: tone; opacity: cross }
        line { from: 12, 13; to: 18, 7; width: 1.6; color: tone; opacity: cross }
    }

    //  A bell, and its clapper.
    component BellGlyph(tone: color) {
        size: 20, 20
        path { at: 10, 9; color: tone
               move -5.5, 3.5; line -5.5, -0.5; curve 5.5, -0.5 via 0, -11; line 5.5, 3.5; line 7, 5; line -7, 5; close }
        ellipse { at: 10, 16; radius: 1.6; color: tone }
    }

    //  Power: a ring open at the top (an ∩ arc turned over), and its bar.
    component PowerGlyph(tone: color) {
        size: 20, 20
        arc { at: 10, 11; radius: 7; span: 290deg; width: 1.8; rotate: 180deg; color: tone }
        line { from: 10, 2.5; to: 10, 9.5; width: 1.8; color: tone }
    }

    //  Restart: the same ring, and an arrowhead on its left end, pointing
    //  clockwise into the gap.
    component RebootGlyph(tone: color) {
        size: 20, 20
        arc { at: 10, 10.5; radius: 6.5; span: 290deg; width: 1.8; rotate: 180deg; color: tone }
        path { at: 10, 10.5; color: tone; move -1.1, -7.1; line -2.3, -3.2; line -5.2, -7.5; close }
    }

    //  The moon: a disc, bitten by a disc of the tile's own colour.
    component MoonGlyph(tone: color, ground: color) {
        size: 20, 20
        ellipse { at: 10, 10; radius: 7; color: tone }
        ellipse { at: 13.5, 6.5; radius: 6; color: ground }
    }


    // ── the rules ────────────────────────────────────────────────
    on toggle      { open = if(suppress, open, not open) }
    on key Escape  { pwd_open = false; ask = 0; open = false }
    every 600ms while bt.discovering { toggle beat }

    //  A press on the dim lands here only where nothing above caught it:
    //  outside the panel, or on its bare parts. So the rule itself tells the
    //  panel's rectangle (380 × 622 at screen.width - 387, 50).
    on press dim {
        open = if(local.x < screen.width - 387 or local.x > screen.width - 7
                  or local.y < 50 or local.y > 672, false, open)
        pwd_open = if(local.x < screen.width - 387 or local.x > screen.width - 7
                      or local.y < 50 or local.y > 672, false, pwd_open)
        ask = if(local.x < screen.width - 387 or local.x > screen.width - 7
                 or local.y < 50 or local.y > 672, 0, ask)
    }
    //  On the panel around a dialog: the dialog goes (pairing waits for its answer).
    on press modal      { pwd_open = false; ask = 0 }

    on press close_hit  { open = false }
    on press mute_hit   { emit mute }
    on press notes_hit  { emit open_notes }
    on press off_hit    { emit ask_power(1) }
    on press reboot_hit { emit ask_power(2) }
    on press suspend_hit { emit suspend }
    on ask_power(v)     { ask_last = v }
    on press ask_cancel { ask = 0 }
    on press ask_ok     { emit do_power }
    on press pwd_cancel { pwd_open = false }
    on press pwd_ok     { emit pwd_submit }
    on press pair_no    { emit pair_reject }
    on press pair_yes   { emit pair_accept }
    on press scan_hit   { emit bt_scan }
    //  local.x includes the zone's from:, so it is measured against the
    //  track's own start (screen.width - 311), 274 wide.
    on press track      { volume = clamp((local.x - screen.width + 311) / 274, 0, 1); emit volume_set(clamp((local.x - screen.width + 311) / 274, 0, 1)) }
    on drag track       { volume = clamp((local.x - screen.width + 311) / 274, 0, 1); emit volume_set(clamp((local.x - screen.width + 311) / 274, 0, 1)) }
    on submit pwd_value { emit pwd_submit }
    on submit pair_code { emit pair_answer }

    //  The field is kept ready while its dialog is up.
    every 250ms while pwd_open { focus pwd_value }
    every 250ms while bt.pairing == pin { focus pair_code }
    every 250ms while bt.pairing == passkey { focus pair_code }
}
