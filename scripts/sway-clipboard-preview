#!/bin/sh
# Make (once) a small PNG of one entry of the history and print its file:// URL.
set -eu

cliphist_bin="${CLIPHIST:-cliphist}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pleamar/clipboard-previews"
clipboard_id="${1:-}"

case "$clipboard_id" in
    ''|*[!0-9]*) exit 2 ;;
esac

mkdir -p "$cache_dir"

preview_file="$cache_dir/$clipboard_id.png"
temporary_file="$cache_dir/.$clipboard_id.$$.png"

if [ ! -s "$preview_file" ]; then
    trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

    "$cliphist_bin" decode "$clipboard_id" |
        magick \
            -limit memory 64MiB \
            -limit map 128MiB \
            -limit disk 256MiB \
            - \
            -auto-orient \
            -thumbnail '96x64>' \
            -strip \
            "png:$temporary_file"

    mv "$temporary_file" "$preview_file"
    trap - EXIT HUP INT TERM
fi

printf 'file://%s\n' "$preview_file"
